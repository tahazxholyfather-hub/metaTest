# Deploy artifact for SEC-011 and SEC-012. Not applied by the app.
# Copy to the cPanel document root (usually public_html/.htaccess).
# If the panel "Force HTTPS Redirect" is already on, delete the rewrite block
# or the site will redirect in a loop. Read the error log if port 80 returns 500
# before relying on this rewrite.

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

Options -Indexes -ExecCGI

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://socket.metatest.app https://socket.metatest.app; media-src 'self' blob:; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
</IfModule>
