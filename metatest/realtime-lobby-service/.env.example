NODE_ENV=development
PORT=4003
CORS_ORIGIN=https://metatest.app

# Required. At least 32 characters. Generate a new value; do not reuse a committed secret.
JWT_SECRET=
JWT_AUDIENCE=
JWT_ISSUER=

STORAGE_DRIVER=memory
REDIS_URL=redis://localhost:6379

MAIN_BACKEND_URL=https://metatest.app/api
MAIN_BACKEND_API_KEY=
MAIN_BACKEND_INTERNAL_KEY=

LOBBY_MAX_MEMBERS=50
LOBBY_CODE_LENGTH=6
RESULTS_TTL_SECONDS=60
WAITING_ROOM_JOIN_LOCK_ON_START=true

SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000

LOG_LEVEL=info
