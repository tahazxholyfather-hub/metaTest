NODE_ENV=development
PORT=4003

# Comma-separated. Keep both so you can develop locally and deploy later
# without editing this every time.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://metatest.app

JWT_SECRET=change-me-to-a-long-random-secret
JWT_AUDIENCE=
JWT_ISSUER=

STORAGE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# --- Local ---
MAIN_BACKEND_URL=http://localhost:3000/api

# --- Production (comment local URL above and use these) ---
# MAIN_BACKEND_URL=https://metatest.app/api

MAIN_BACKEND_FLOW_URL=
MAIN_BACKEND_INTERNAL_BASE=
MAIN_BACKEND_API_KEY=
# Must match the main API INTERNAL_SERVICE_KEY
MAIN_BACKEND_INTERNAL_KEY=

# Leave unset unless the frontend AND main API also use a custom salt.
# Default matches metatest/src/utils/hash.ts
HASHIDS_SALT=

LOBBY_MAX_MEMBERS=50
LOBBY_CODE_LENGTH=6
RESULTS_TTL_SECONDS=60
WAITING_ROOM_JOIN_LOCK_ON_START=true
DISCONNECT_GRACE_MS=3000
PROFILE_CACHE_TTL_MS=45000

SOCKET_PING_TIMEOUT=25000
SOCKET_PING_INTERVAL=20000

LOG_LEVEL=debug
