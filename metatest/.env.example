# One switch for the whole app.
# true  = this computer: site at /, socket at http://localhost:4000, API at localhost:3000
# false = cPanel: site at https://metatest.app/app, socket at https://socket.metatest.app
#
# The frontend reads this when you build, not from the running API.
# cPanel upload: LOCALHOST=false npm run build, then upload dist into public_html/app
# (including public/.htaccess). An old bundle still navigates to /dashboard.
LOCALHOST=true

# cPanel only. Folder LiteSpeed serves as the site root. Defaults to $HOME/public_html.
# WEB_ROOT=/home/USERNAME/public_html

# Optional. If both are empty the API writes src/backend/data/vapid.json once (gitignored).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@metatest.app

# Set to true only after public/music tracks exist. Otherwise Chemball does not probe missing files.
# VITE_CHEMBALL_MUSIC=true
