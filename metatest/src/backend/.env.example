PORT=3000
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=quiz_app
API_URL=http://localhost:3000/api/flow
# Shared client token is NOT an admin credential. Leave empty unless a legacy client still needs it.
APP_TOKEN=
VITE_API_BASE_URL=http://localhost:3000/api
BASE_URL=http://localhost:5173/
FRONTEND_URL=http://localhost:5173/
# Comma-separated browser origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:5173

# Must stay false on any shared or public host. Only honored from localhost.
DEV_MODE=false
NODE_ENV=development

# Generate new values. Do not reuse anything that was ever committed.
JWT_SECRET=
SOCKET_JWT_SECRET=
ADMIN_SESSION_SECRET=
# At least 16 random characters. Use 32 or more. The public /api/internal proxy
# reaches this process from 127.0.0.1, so the key is what stops the internet.
INTERNAL_SERVICE_KEY=
PAYMENT_RESULT_SECRET=

# Admin panel passwords. Username is admin1 .. admin20. No default password.
# ADMIN_1_PASSWORD=
# Or a JSON map: ADMIN_PASSWORDS={"1":"...","2":"..."}

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_ACCESS_TOKEN=

OPENAI_API_KEY=
AI_PROVIDER_BASE_URL=https://api.gapgpt.app/v1
AI_TEACHER_MODEL=gpt-5.6-luna
AI_TEACHER_MODEL_LOW=gpt-5.6-luna
AI_TEACHER_MODEL_MEMORY=gpt-5.6-luna
AI_TEACHER_TIMEOUT_MS=90000

TZ=Asia/Tehran
AI_TEACHER_USD_TO_IRR=2000000

SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_LINE=
