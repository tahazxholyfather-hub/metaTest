# GapGPT / AI Teacher — copy to backend/.env for testing
# Docs: https://gapgpt.app/platform-v2/docs/quickstart
# Models: https://gapgpt.app/platform-v2/docs/models/gpt-5-6

# Required — API key from GapGPT platform dashboard
GAPGPT_API_KEY=your_gapgpt_api_key_here

# OpenAI-compatible base (include /v1)
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# or:
# AI_PROVIDER_BASE_URL=https://api.gapgpt.app/v1

# Models: gpt-5.6-luna (cheap/fast) | gpt-5.6-terra | gpt-5.6-sol
AI_TEACHER_MODEL=gpt-5.6-luna
AI_TEACHER_MODEL_LOW=gpt-5.6-luna
AI_TEACHER_MODEL_MEMORY=gpt-5.6-luna
AI_TEACHER_MODEL_VISION=gpt-5.6-terra
AI_TEACHER_MODEL_TOOLS=gpt-5.6-terra
AI_TEACHER_EMBEDDING_MODEL=text-embedding-3-small
AI_TEACHER_IMAGE_MODEL=dall-e-3

# Feature toggles — fail closed if the gateway rejects a param
AI_TEACHER_ENABLE_TOOLS=true
AI_TEACHER_ENABLE_IMAGE_GEN=true
AI_TEACHER_ENABLE_VISION=true
AI_TEACHER_ENABLE_RAG=true
AI_TEACHER_IMAGE_ENERGY_COST=40

# Optional
AI_PROVIDER_NAME=gapgpt
AI_TEACHER_TIMEOUT_MS=90000
# Set true only if your gateway supports OpenAI stream_options.include_usage
AI_PROVIDER_STREAM_USAGE=false
