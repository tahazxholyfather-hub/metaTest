# ─────────────────────────────────────────────────────────────────────────────
# Met — AI subsystem configuration (copy the lines you need into backend/.env)
#
# Everything is optional except AI_API_KEY. With AI_ENABLED=false the whole AI
# area shows a polished "unavailable" state and the rest of MetaTest keeps
# working. Each capability degrades gracefully when its flag is off or its
# model is missing. Provider keys never reach the frontend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin panel (separate from student JWT) ──────────────────────────────────
# ADMIN_JWT_SECRET=change-me-independently-of-student-jwt
# ADMIN_SUPER_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=Admin@1   # used only if admin id=1 is missing; change immediately
# FRONTEND_ORIGIN=http://localhost:5173   # comma-separated allowed CORS origins for admin cookies

# ── Master switch ────────────────────────────────────────────────────────────
AI_ENABLED=true

# ── Provider (OpenAI-compatible; GapGPT by default) ──────────────────────────
AI_PROVIDER=gapgpt
AI_API_KEY=your_provider_api_key_here
AI_BASE_URL=https://api.gapgpt.app/v1
# Request timeout in ms (streaming + non-streaming)
AI_TIMEOUT_MS=90000
# Ask the provider to include token usage in streamed responses
AI_STREAM_USAGE=true

# ── Models — one per capability ──────────────────────────────────────────────
# Main chat model (balanced); fast/cheap model for low-coin & "fast" reasoning;
# deep model for "deep" reasoning; utility model for titles/memory/summaries/suggestions.
AI_TEXT_MODEL=gpt-5.6-luna
AI_TEXT_MODEL_FAST=gpt-5.6-luna
AI_TEXT_MODEL_DEEP=gpt-5.6-terra
AI_UTILITY_MODEL=gpt-5.6-luna
AI_VISION_MODEL=gpt-5.6-terra
AI_TOOLS_MODEL=gpt-5.6-terra
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_IMAGE_MODEL=dall-e-3
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# ── Feature flags (true/false) ───────────────────────────────────────────────
AI_CHAT_ENABLED=true
AI_VISION_ENABLED=true             # students can attach images; Met reads them
AI_IMAGE_GENERATION_ENABLED=true   # Met can draw diagrams (flat coin surcharge)
AI_STT_ENABLED=true                # voice input → text
AI_TTS_ENABLED=true                # read answers aloud
AI_PDF_REFERENCES_ENABLED=true     # up to AI_MAX_PDFS_PER_CONVERSATION PDFs per chat
AI_MEMORY_ENABLED=true             # long-term student memory (auditable)
AI_KNOWLEDGE_BASE_ENABLED=true     # human-authored knowledge (tam24_ai_knowledge)
AI_TOOLS_ENABLED=true              # question-bank search, learning profile, …
AI_SUGGESTIONS_ENABLED=true        # smart conversation starters

# ── Coins ────────────────────────────────────────────────────────────────────
# 1 coin = AI_IRR_PER_COIN rials of real provider cost. Daily coins reset every
# local calendar day and never roll over; purchased coins never expire.
AI_USD_TO_IRR=1000000
AI_IRR_PER_COIN=100
AI_DAILY_FREE_COINS=80
AI_DAILY_COINS_BRONZE=300
AI_DAILY_COINS_SILVER=500
AI_DAILY_COINS_GOLDEN=1000
AI_DAILY_COINS_DIAMOND=1500
AI_DAILY_COINS_EPIC=1500
AI_DAILY_COINS_PREMIUM=800

# Flat coin prices for non-token operations (per-model overrides live in tam24_ai_model_pricing)
AI_IMAGE_COIN_COST=40
AI_STT_COIN_COST=2
AI_TTS_COIN_COST=6
AI_PDF_INDEX_COIN_COST=0

# ── Files & limits ───────────────────────────────────────────────────────────
AI_MAX_IMAGE_MB=8
AI_MAX_AUDIO_MB=15
AI_MAX_PDF_MB=30
AI_MAX_PDFS_PER_CONVERSATION=4
AI_MAX_PDF_PAGES=600
# Override the web root that /uploads/ai/* is written under (defaults to backend/public)
# AI_UPLOAD_ROOT=/var/www/metatest/public

# ── Rate limits (per user, per minute) ───────────────────────────────────────
AI_RATE_LIMIT_CHAT_PER_MINUTE=20
AI_RATE_LIMIT_UPLOADS_PER_MINUTE=15
AI_RATE_LIMIT_VOICE_PER_MINUTE=15
